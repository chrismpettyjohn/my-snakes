{
  "name": "snake-keeper",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter web build",
    "start": "bun run --filter api start",
    "dev:start": "pm2 start ecosystem.config.cjs --update-env && pm2 list",
    "dev:stop": "pm2 delete ecosystem.config.cjs",
    "dev:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "dev:logs": "pm2 logs",
    "dev:status": "pm2 list",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . && knip",
    "lint:fix": "eslint . --fix && knip --fix",
    "db:up": "docker compose --env-file apps/api/.env up -d",
    "db:down": "docker compose --env-file apps/api/.env down",
    "db:migrate": "bun run --filter api db:migrate",
    "db:revert": "bun run --filter api db:revert",
    "db:create": "bun run --filter api db:create"
  },
  "devDependencies": {
    "eslint": "9",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "gts": "^7.0.0",
    "knip": "^6.45.1",
    "pm2": "7.0.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0"
  }
}
