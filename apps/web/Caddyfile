# SITE_ADDRESS: your domain (e.g. snakes.example.com) for automatic HTTPS, or ":80" for plain HTTP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
