# API config. Copy to apps/api/.env (`cp .env.example .env`); bun loads it automatically.
# Dev defaults below; production notes inline.

# "production" enables safety checks (e.g. rejects the placeholder secrets below).
NODE_ENV=development
PORT=3000

# --- Database (docker compose up -d) ---
DATABASE_URL=postgres://snake:snake@localhost:5433/snake
# Used by the compose `db` service. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=snake

# --- Secrets (generate each with: openssl rand -hex 32) ---
# Signs session tokens.
JWT_SECRET=change-me
# Encrypts per-user Govee API keys at rest (32+ chars).
SECRET_KEY=change-me-to-a-long-random-string-32chars

# --- Public URLs ---
# Base URL the API is reachable at from outside. Herpstat upload URLs are built from it.
PUBLIC_API_URL=http://localhost:3000
# Origin(s) the web app is served from, comma-separated.
CORS_ORIGIN=http://localhost:5173

# --- Optional ---
GOVEE_POLL_SECONDS=300
HERPSTAT_POLL_SECONDS=30
READINGS_RETENTION_DAYS=14
MIGRATE_ON_BOOT=true
# LAN /24 prefixes to scan for Herpstats, comma-separated (e.g. 192.168.1).
HERPSTAT_SCAN_SUBNETS=
