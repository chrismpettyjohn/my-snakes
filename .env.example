DATABASE_URL=postgres://snake:snake@localhost:5433/snake
JWT_SECRET=change-me
# Encrypts per-home Govee API keys at rest (32+ chars)
SECRET_KEY=change-me-to-a-long-random-string-32chars
PUBLIC_API_URL=http://localhost:3000
PORT=3000
GOVEE_POLL_SECONDS=300
CORS_ORIGIN=http://localhost:5173
HERPSTAT_POLL_SECONDS=30
READINGS_RETENTION_DAYS=14
MIGRATE_ON_BOOT=true
# Docker only: LAN /24 prefixes to scan for Herpstats (comma-separated)
HERPSTAT_SCAN_SUBNETS=

# --- Docker (full stack) ---
# Domain for automatic HTTPS, or ":80" for plain HTTP
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PASSWORD=snake
# Public origin, e.g. https://snakes.example.com (Herpstat upload URLs are built from it)
PUBLIC_URL=http://localhost
